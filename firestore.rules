rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // Usuarios
    match /usuarios/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && request.auth.uid == userId;
    }

    // Publicaciones Vendo
    match /publicaciones_vendo/{pubId} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAuth() && resource.data.comercioId == request.auth.uid;
    }

    // Publicaciones Busco
    match /publicaciones_busco/{pubId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.clienteId == request.auth.uid;
    }

    // Ofertas
    match /ofertas_comercio/{ofertaId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
    }

    // Chats
    match /chats/{chatId} {
      allow read, update: if isAuth() && (
        resource.data.clienteId == request.auth.uid ||
        resource.data.comercioId == request.auth.uid
      );
      allow create: if isAuth();
    }

    // Mensajes
    match /mensajes/{msgId} {
      allow read, create: if isAuth();
    }

    // Pedidos
    match /pedidos/{pedidoId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
    }

    // Calificaciones
    match /calificaciones/{calId} {
      allow read: if isAuth();
      allow create: if isAuth();
    }

    // Solicitudes de envío
    match /solicitudes_envio/{envioId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
    }
  }
}
